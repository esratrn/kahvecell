# Bu dosyayı .env adıyla kopyalayıp değerleri değiştirebilirsin. Yorum satırı bırakılanlar varsayılanı kullanır.
# Üretim ortamında anahtarlar MUTLAKA değiştirilmeli (en az 32 karakter, rastgele).

# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./kahvecell.db
# CORS_ORIGINS=["http://localhost:5173"]

# JWT_SECRET_KEY=degistir-en-az-32-karakter-rastgele-bir-deger
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# QR_SIGNING_KEY=degistir-jwt-anahtarindan-farkli-rastgele-bir-deger

# SMS simülasyonu (case 11.2: sabit kod 1234)
# OTP_CODE=1234
# OTP_EXPIRE_MINUTES=3
# OTP_MAX_ATTEMPTS=5
